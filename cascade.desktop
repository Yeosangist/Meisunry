[Desktop Entry]
Name=Cascade
Comment=A minimalist, offline masonry image viewer
Exec=Cascade %U
Categories=Graphics;Viewer;
Icon=Cascade
StartupNotify=true
Terminal=false
Type=Application
Path=/usr/lib/Cascade
MimeType=inode/directory;image/jpeg;image/png;image/avif;image/gif;image/jfif;image/webp;video/mp4;video/webm;video/x-matroska;video/avi;video/quicktime;video/x-ms-wmv;video/x-flv;video/MP2T;
