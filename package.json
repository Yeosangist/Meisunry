{
  "name": "Cascade",
  "version": "1.0.1",
  "description": "A masonry image viewer",
  "main": "./mains/main.js",
  "scripts": {
    "start": "electron ./mains/main.js",
    "package": "electron-builder package",
    "make": "electron-builder make"
  },
  "author": "Yeosangist",
  "license": "MIT",
  "devDependencies": {
    "@electron-builder/cli": "^7.5.0",
    "@electron-builder/maker-deb": "^7.5.0",
    "@electron-builder/maker-rpm": "^7.5.0",
    "@electron-builder/maker-zip": "^7.5.0",
    "@electron-builder/plugin-auto-unpack-natives": "^7.5.0",
    "@electron-builder/plugin-fuses": "^7.5.0",
    "@electron/fuses": "^1.8.0",
    "electron": "^26.1.0"
  },
  "dependencies": {
    "electron-context-menu": "^3.6.1",
    "masonry-layout": "^4.2.2",
    "panzoom": "^9.4.3",
    "trash": "^8.1.1"
  },
  "build": {
  "appId": "com.yeosangist.cascade",
  "productName": "Cascade",
  "directories": {
    "output": "dist"
  },
  "files": [
    "**/*",
    "!**/node_modules",
    "!**/*.md",
    "!**/cascade.desktop"
  ],
    "win": {
      "icon": "/app-icons/logo.ico"
    },
    "darwin": {
      "icon": "/app-icons/logo.png"
    },
    "linux": {
	  "target": ["AppImage", "deb", "rpm"],
      "icon": "/app-icons/logo.png"
    },
    "asar": true
  }
}
